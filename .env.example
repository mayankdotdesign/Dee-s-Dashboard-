# Copy to .env.local for local dev. In production, set these as Vercel
# environment variables (Project Settings → Environment Variables).

# Password gate (src/proxy.ts + the branded /login page). Skipped locally if unset.
DASHBOARD_PASSWORD=

# ScrapeCreators API key — used by /api/cron/refresh (monthly tracked-list
# refresh) and /api/lookup (on-demand @username search).
SCRAPECREATORS_API_KEY=

# Neon Postgres connection string — added automatically as a Vercel env var
# once the Neon Marketplace integration is connected to this project. The app
# is fully DB-backed, so this is required.
DATABASE_URL=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# calls /api/cron/refresh. Any random string; generate with
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
CRON_SECRET=
