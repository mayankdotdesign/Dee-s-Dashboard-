# Copy to .env.local for local dev. In production, set these as Vercel
# environment variables (Project Settings → Environment Variables).

# HTTP Basic Auth password gate (middleware.ts). Any username works.
DASHBOARD_PASSWORD=

# ScrapeCreators API key — production account, separate from the one used
# for Phase 1 research. Only needed once Phase 3 (live ingestion) is wired.
SCRAPECREATORS_API_KEY=

# Neon Postgres connection string — added automatically as a Vercel env var
# once the Neon Marketplace integration is connected to this project.
DATABASE_URL=
